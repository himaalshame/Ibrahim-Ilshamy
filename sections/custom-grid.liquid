<div class="custom-grid">
  <h2 class="custom-grid__heading">{{ section.settings.heading }}</h2>
  <div class="custom-grid__container">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product %}
        <div class="custom-grid__item" data-product-handle="{{ product.handle }}">
          <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" loading="lazy">
          <button class="custom-grid__plus" data-open-popup aria-label="Quick view {{ product.title }}">+</button>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<!-- Popup -->
<div class="product-popup" id="product-popup" hidden>
  <div class="product-popup__overlay" data-close-popup></div>
  <div class="product-popup__box">
    <button class="product-popup__close" data-close-popup aria-label="Close">&times;</button>
    <div class="product-popup__image">
      <img id="popup-image" src="" alt="">
    </div>
    <div class="product-popup__details">
      <h3 id="popup-title"></h3>
      <p id="popup-price"></p>
      <p id="popup-description"></p>

      <div id="popup-options"></div>

      <button id="popup-add-to-cart" class="product-popup__add-btn">
        ADD TO CART <span>&rarr;</span>
      </button>
    </div>
  </div>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Lustria&display=swap');
.custom-grid {
    font-family: 'Lustria', serif;
    padding: 40px 0;
    max-width: 88%;
    margin: 0 auto; 
    margin-top: 70px;

}
.custom-grid__heading {
  font-family: 'Lustria', serif;
  font-size: 36px;
  font-weight: 400;
  
}
.custom-grid__container {
  display: grid;
  grid-template-columns: repeat(3, 433fr);
  gap: 0px;
  
  
}
.custom-grid__item {
  position: relative;
  width:100%; 
  aspect-ratio: 1 / 1;
  overflow: hidden;
}
.custom-grid__item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  margin:30px 30px 30px;

}
.custom-grid__plus {
  position: absolute;
  top: 10%;
  right: 8%;
  border-radius: 50%;
  background: #fff;
  border: none;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 749px) {
  .custom-grid__container { grid-template-columns: repeat(2, 1fr); }
}

/* Popup */
.product-popup {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-popup[hidden] { display: none; }
.product-popup__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
}
.product-popup__box {
  position: relative;
  background: #fff;
  border-radius: 8px;
  padding: 24px;
  max-width: 480px;
  width: 90%;
  display: flex;
  gap: 20px;
  z-index: 1;
}
.product-popup__image img {
  width: 140px;
  height: 140px;
  object-fit: cover;
  border-radius: 6px;
}
.product-popup__close {
  position: absolute;
  top: 12px;
  right: 12px;
  background: none;
  border: none;
  font-size: 22px;
  cursor: pointer;
}
.product-popup__details h3 { margin: 0 0 8px; font-size: 20px; }
.product-popup__details p { margin: 0 0 8px; font-size: 14px; color: #444; }
.popup-option-group { margin-bottom: 12px; }
.popup-option-group label { display: block; font-size: 13px; margin-bottom: 6px; font-weight: 600; }
.popup-option-values { display: flex; gap: 8px; flex-wrap: wrap; }
.popup-option-btn, .popup-option-select {
  padding: 8px 14px;
  border: 1px solid #ccc;
  background: #fff;
  cursor: pointer;
  font-size: 13px;
}
.popup-option-btn.selected { border-color: #000; background: #000; color: #fff; }
.product-popup__add-btn {
  margin-top: 12px;
  width: 100%;
  padding: 12px;
  background: #000;
  color: #fff;
  border: none;
  cursor: pointer;
  font-weight: 600;
}
.product-popup__add-btn:disabled { opacity: 0.5; cursor: not-allowed; }

@media (max-width: 749px) {
  .product-popup__box { flex-direction: column; }
  .product-popup__image img { width: 100%; height: auto; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // Product data injected from Liquid for each block
  var products = {
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product %}
        "{{ product.handle }}": {
          title: {{ product.title | json }},
          price: {{ product.price | money | json }},
          description: {{ product.description | strip_html | truncate: 150 | json }},
          image: {{ product.featured_image | image_url: width: 400 | json }},
          variants: [
            {% for variant in product.variants %}
              {
                id: {{ variant.id | json }},
                title: {{ variant.title | json }},
                option1: {{ variant.option1 | json }},
                option2: {{ variant.option2 | json }},
                available: {{ variant.available | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          options: {{ product.options_with_values | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  };

  var popup = document.getElementById('product-popup');
  var popupImage = document.getElementById('popup-image');
  var popupTitle = document.getElementById('popup-title');
  var popupPrice = document.getElementById('popup-price');
  var popupDescription = document.getElementById('popup-description');
  var popupOptions = document.getElementById('popup-options');
  var addToCartBtn = document.getElementById('popup-add-to-cart');

  var currentProduct = null;
  var selectedOptions = {};

  // Open popup when "+" is clicked
  document.querySelectorAll('[data-open-popup]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var handle = btn.closest('.custom-grid__item').dataset.productHandle;
      currentProduct = products[handle];
      selectedOptions = {};
      if (!currentProduct) return;

      popupImage.src = currentProduct.image;
      popupTitle.textContent = currentProduct.title;
      popupPrice.textContent = currentProduct.price;
      popupDescription.textContent = currentProduct.description;

      renderOptions();
      popup.hidden = false;
    });
  });

  function renderOptions() {
    popupOptions.innerHTML = '';
    currentProduct.options.forEach(function (opt, index) {
      var group = document.createElement('div');
      group.className = 'popup-option-group';

      var label = document.createElement('label');
      label.textContent = opt.name;
      group.appendChild(label);

      var valuesWrap = document.createElement('div');
      valuesWrap.className = 'popup-option-values';

      opt.values.forEach(function (value) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'popup-option-btn';
        btn.textContent = value;
        btn.addEventListener('click', function () {
          selectedOptions['option' + (index + 1)] = value;
          valuesWrap.querySelectorAll('.popup-option-btn').forEach(function (b) {
            b.classList.remove('selected');
          });
          btn.classList.add('selected');
          updateAddToCartState();
        });
        valuesWrap.appendChild(btn);
      });

      group.appendChild(valuesWrap);
      popupOptions.appendChild(group);
    });
    updateAddToCartState();
  }

  function findMatchingVariant() {
    return currentProduct.variants.find(function (v) {
      return Object.keys(selectedOptions).every(function (key) {
        return v[key] === selectedOptions[key];
      });
    });
  }

  function updateAddToCartState() {
    var variant = findMatchingVariant();
    addToCartBtn.disabled = !variant || !variant.available;
  }

  // Close popup
  document.querySelectorAll('[data-close-popup]').forEach(function (el) {
    el.addEventListener('click', function () {
      popup.hidden = true;
    });
  });

  // Add to cart
  addToCartBtn.addEventListener('click', function () {
    var variant = findMatchingVariant();
    if (!variant) return;

    var items = [{ id: variant.id, quantity: 1 }];

    // Special rule: if Black + Medium selected, also add "Soft Winter Jacket"
    if (selectedOptions.option1 === 'Black' && selectedOptions.option2 === 'Medium') {
      {% assign winter_jacket = all_products['soft-winter-jacket'] %}
      {% if winter_jacket %}
        {% assign winter_variant = winter_jacket.variants.first %}
        items.push({ id: {{ winter_variant.id | json }}, quantity: 1 });
      {% endif %}
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
      .then(function (res) { return res.json(); })
      .then(function () {
        popup.hidden = true;
        alert('Added to cart!');
      })
      .catch(function (err) {
        console.error('Add to cart failed:', err);
      });
  });
});
</script>

{% schema %}
{
  "name": "Custom Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}