<div class="custom-banner">
  <div class="custom-banner__content">
    <h2 class="custom-banner__heading">{{ section.settings.heading }}</h2>
    <p class="custom-banner__text">{{ section.settings.description }}</p>
    <a href="{{ section.settings.button_link }}" class="custom-banner__button">
      {{ section.settings.button_text }}
    </a>
  </div>
</div>

<style>
.custom-banner {
  padding: 60px 20px;
  text-align: center;
  background-color: #f4f1ec;
}

.custom-banner__heading {
  font-size: 32px;
  margin-bottom: 16px;
}

.custom-banner__text {
  font-size: 16px;
  margin-bottom: 24px;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

.custom-banner__button {
  display: inline-block;
  padding: 12px 32px;
  background-color: #000;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.custom-banner__button:hover {
  transform: scale(1.05);
  background-color: #333;
}

@media (max-width: 749px) {
  .custom-banner__heading {
    font-size: 24px;
  }
}
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our range of items perfect for this holiday season"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}