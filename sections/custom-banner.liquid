```liquid
<section
  class="custom-banner"
  style="
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
    {% endif %}
  "
>
  <!-- Top Announcement -->
  <div class="nav-bar">
    <div class="nav-logo">
      {{ section.settings.logo_text }}
    </div>

    <div class="nav-message">
      <span>{{ section.settings.top_message }}</span>
    </div>

    <div class="nav-action">
      <a
        href="{{ section.settings.top_btn_link | default: '#' }}"
        class="choose-gift-btn"
      >
        {{ section.settings.top_btn_text }} <span>&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Hero Content -->
  <div class="hero-content">
    <h1>{{ section.settings.heading }}</h1>

    <p>
      {{ section.settings.description }}
    </p>

    <a
      href="{{ section.settings.button_link | default: '#' }}"
      class="shop-btn"
    >
      {{ section.settings.button_text }}
    </a>
  </div>

  <!-- Bottom Ticker -->
  <div class="bottom-ticker">
    <span>{{ section.settings.bottom_ticker_text }}</span>
  </div>
</section>

<style>
  * {
    box-sizing: border-box;
  }

  .custom-banner {
    position: relative;

    width: 100%;
    min-height: 100vh;

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    display: flex;
    flex-direction: column;

    overflow: hidden;
    color: #111;
  }

  /* =========================
     TOP NAV
  ========================= */

  .nav-bar {
    width: 100%;
    min-height: 70px;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    padding: 0 40px;

    background: #f7f7f7;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .nav-logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .nav-message {
    text-align: center;
    font-size: 15px;
    font-weight: 500;
  }

  .nav-action {
    display: flex;
    justify-content: flex-end;
  }

  .choose-gift-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 13px 22px;

    background: #000;
    color: #fff;

    text-decoration: none;

    font-size: 13px;
    font-weight: 700;

    transition: 0.3s ease;
  }

  .choose-gift-btn:hover {
    background: #333;
  }

  /* =========================
     HERO CONTENT
  ========================= */

  .hero-content {
    flex: 1;

    width: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 80px 20px;
  }

  .hero-content h1 {
    margin: 0 0 20px;

    font-size: clamp(48px, 7vw, 100px);
    line-height: 0.95;

    font-weight: 800;
    letter-spacing: -3px;
  }

  .hero-content p {
    max-width: 650px;

    margin: 0 0 30px;

    font-size: 18px;
    line-height: 1.6;

    font-weight: 500;
  }

  .shop-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 180px;

    padding: 16px 30px;

    background: #000;
    color: #fff;

    text-decoration: none;

    font-size: 14px;
    font-weight: 700;

    transition: 0.3s ease;
  }

  .shop-btn:hover {
    background: #333;
    transform: translateY(-2px);
  }

  /* =========================
     BOTTOM TICKER
  ========================= */

  .bottom-ticker {
    width: 100%;

    padding: 13px 20px;

    background: #000;
    color: #fff;

    text-align: center;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 1px;
  }

  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 768px) {

    .custom-banner {
      min-height: 100svh;
    }

    .nav-bar {
      grid-template-columns: 1fr auto;

      padding: 15px 20px;

      gap: 15px;
    }

    .nav-logo {
      font-size: 17px;
    }

    .nav-message {
      display: none;
    }

    .nav-action {
      justify-content: flex-end;
    }

    .choose-gift-btn {
      padding: 11px 15px;
      font-size: 11px;
    }

    .hero-content {
      padding: 60px 20px;
    }

    .hero-content h1 {
      font-size: clamp(42px, 13vw, 65px);
      letter-spacing: -2px;
    }

    .hero-content p {
      font-size: 15px;
      max-width: 90%;
    }

    .shop-btn {
      width: 180px;
    }

    .bottom-ticker {
      font-size: 10px;
      padding: 12px 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top Announcement Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_ticker_text",
      "label": "Bottom Ticker Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
```
