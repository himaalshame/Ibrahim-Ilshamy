<div class="custom-banner-wrapper">
  <!-- Top Navbar / Announcement Bar -->
  <div class="top-navbar">
    <div class="nav-logo">
      <a href="#">{{ section.settings.logo_text }}</a>
    </div>
    
    <div class="nav-message">
      <span>{{ section.settings.top_message }}</span>
    </div>
    
    <div class="nav-action">
      <a href="{{ section.settings.top_btn_link | default: '#' }}" class="choose-gift-btn">
        {{ section.settings.top_btn_text }} &rarr;
      </a>
    </div>
  </div>

  <!-- Hero Banner Section -->
  <div class="hero-banner-container">
    

    <div class="hero-image-wrapper">

  {% if section.settings.bg_image != blank %}
    <img
      src="{{ section.settings.bg_image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="hero-bg-img"
      loading="eager"
      width="{{ section.settings.bg_image.width }}"
      height="{{ section.settings.bg_image.height }}"
    >
  {% endif %}

</div>


    <div class="banner-overlay-content">
      <h1 class="banner-title">{{ section.settings.heading }}</h1>
      <p class="banner-description">{{ section.settings.description | replace: '//', '<br>' }}</p>
      <a href="{{ section.settings.button_link | default: '#' }}" class="banner-shop-btn">
        <span>{{ section.settings.button_text }}</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>

  </div>

  <!-- Bottom Ticker Bar -->
  <div class="bottom-ticker-bar">
    <p>{{ section.settings.bottom_ticker_text }}</p>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;600;700&display=swap');
  .custom-banner-wrapper {
    width: 100%;
    position: relative;
  }

 /* =========================
   HERO CONTAINER
========================= */

.hero-banner-container {
  position: relative;
  width: 100%;

  /* نفس نسبة صورة التصميم */
  aspect-ratio: 616 / 376;

  height: auto;

  margin: 0;
  padding: 0;

  overflow: hidden;

  background: #fff;
}


/* =========================
   HERO IMAGE
========================= */

.hero-image-wrapper {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  z-index: 1;

  pointer-events: none;
}


.hero-bg-img {
  display: block;

  width: 100%;
  height: 100%;

  /*
    مهم:
    الصورة لا يتم قصها.
    والـ container له نفس نسبة الصورة.
  */
  object-fit: fill;

  margin: 0;
}


/* =========================
   HERO CONTENT
========================= */

.banner-overlay-content {
  position: absolute;

  z-index: 2;

  /*
    مكان المحتوى بالنسبة للرسمة
  */
  left: 4.8%;
  top: 55%;

  width: 36%;

  margin: 0;
}


/* =========================
   TITLE
========================= */

.banner-title {
  margin: 0 0 4% 0;

  font-family: 'Jost', sans-serif;

  /*
    الحجم يكبر ويصغر مع الـ Hero
  */
  font-size: 6cqw;

  font-weight: 500;

  line-height: 0.95;

  color: #000;

  letter-spacing: -0.03em;
}


/* =========================
   DESCRIPTION
========================= */

.banner-description {
  margin: 0 0 6% 0;

  font-family: 'Jost', sans-serif;

  font-size: 1.35cqw;

  font-weight: 400;

  color: #000;

  line-height: 1.4;

  max-width: 31cqw;
}


/* =========================
   SHOP BUTTON
========================= */

.banner-shop-btn {
  display: inline-flex;

  align-items: center;
  justify-content: space-between;

  width: 15cqw;
  height: 5.5cqw;

  padding: 0 1.8cqw;

  box-sizing: border-box;

  font-family: 'Jost', sans-serif;

  background-color: #000;

  color: #fff;

  text-decoration: none;

  font-size: 1.05cqw;

  line-height: 1;
}


.banner-shop-btn .arrow {
  transition: transform 0.3s ease;
}


.banner-shop-btn:hover {
  background-color: #222;
}


.banner-shop-btn:hover .arrow {
  transform: translateX(5px);
}


/* =========================
   TOP MESSAGE
========================= */

.nav-message {
  position: absolute;

  z-index: 10;

  top: 1.5%;

  left: 50%;

  transform: translateX(-50%);

  font-size: 1.1cqw;

  color: #333;

  white-space: nowrap;
}


/* =========================
   CHOOSE GIFT
========================= */

.nav-action {
  position: absolute;

  z-index: 10;

  top: 0.8%;

  right: 3.8%;

  height: 5.5%;
}


.choose-gift-btn {
  display: flex;

  align-items: center;

  height: 100%;

  padding: 0 2cqw;

  background-color: #f7e252;

  color: #000;

  font-size: 1cqw;

  font-weight: bold;

  text-decoration: none;

  border-radius: 2px;

  white-space: nowrap;
}


/* =========================
   LOGO
========================= */

.banner-logo {
  position: absolute;

  z-index: 10;

  top: 1.5%;

  left: 4.8%;

  font-family: Arial, sans-serif;

  font-size: 1.7cqw;

  font-weight: 800;

  color: #000;

  letter-spacing: 0.05em;

  white-space: nowrap;
}


/* =========================
   BOTTOM TICKER
========================= */

.bottom-ticker-bar {
  position: absolute;

  z-index: 10;

  left: 0;
  bottom: 0;

  width: 100%;

  height: 4%;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 0;

  background-color: transparent;

  border: 0;

  font-size: 0.9cqw;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  color: #000;

  white-space: nowrap;
}
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top Announcement Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_ticker_text",
      "label": "Bottom Ticker Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}