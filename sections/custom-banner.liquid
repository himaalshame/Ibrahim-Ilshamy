{% style %}
  /* البار العلوي */
  .top-announcement-bar-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 40px;
    background-color: #ffffff;
    border-bottom: 2px dashed #3182ce;
    font-size: 13px;
    font-weight: 600;
  }

  .announcement-center-{{ section.id }} {
    font-weight: 400;
    color: #4a5568;
  }

  .announcement-btn-{{ section.id }} {
    background-color: #f6e05e;
    color: #000000;
    padding: 8px 18px;
    text-decoration: none;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* السكشن الرئيسي للهيرو */
  .custom-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 520px;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 60px 80px;
    box-sizing: border-box;
    border-bottom: 2px dashed #3182ce;
  }

  .banner-content-{{ section.id }} {
    max-width: 420px;
    z-index: 2;
    text-align: left;
  }

  .banner-title-{{ section.id }} {
    font-size: 52px;
    font-weight: 800;
    color: #000000;
    margin: 0 0 20px 0;
    line-height: 1.05;
    letter-spacing: -1px;
  }

  .banner-text-{{ section.id }} {
    font-size: 14px;
    line-height: 1.6;
    color: #2d3748;
    margin: 0 0 35px 0;
  }

  .banner-button-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background-color: #000000;
    color: #ffffff;
    padding: 14px 28px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
  }

  .banner-button-{{ section.id }}:hover {
    background-color: #333333;
  }

  /* البار السفلي */
  .bottom-info-bar-{{ section.id }} {
    text-align: center;
    padding: 12px;
    background-color: #e2e8f0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #2d3748;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .top-announcement-bar-{{ section.id }} {
      flex-direction: column;
      gap: 10px;
      text-align: center;
      padding: 10px 15px;
    }
    
    .custom-banner-{{ section.id }} {
      padding: 40px 20px;
      min-height: 380px;
    }

    .banner-title-{{ section.id }} {
      font-size: 36px;
    }

    .banner-content-{{ section.id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<!-- البار العلوي -->
<div class="top-announcement-bar-{{ section.id }}">
  <div class="logo-text">TISSO VISON</div>
  <div class="announcement-center-{{ section.id }}">Find the ideal gift for your loved ones.</div>
  <a href="#" class="announcement-btn-{{ section.id }}">CHOOSE GIFT &rarr;</a>
</div>

<!-- الهيرو بنر الرئيسي -->
<div class="custom-banner-{{ section.id }}" 
     style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% endif %}">
  <div class="banner-content-{{ section.id }}">
    {% if section.settings.title != blank %}
      <h1 class="banner-title-{{ section.id }}">{{ section.settings.title }}</h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <p class="banner-text-{{ section.id }}">{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="banner-button-{{ section.id }}">
        {{ section.settings.button_label }} &rarr;
      </a>
    {% endif %}
  </div>
</div>

<!-- البار السفلي -->
<div class="bottom-info-bar-{{ section.id }}">
  SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
</div>

{% schema %}
{
  "name": "Custom Banner Full",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner Full"
    }
  ]
}
{% endschema %}