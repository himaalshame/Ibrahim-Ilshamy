<div class="custom-banner-wrapper">

  {%- comment -%} ================= Top Navbar / Announcement Bar ================= {%- endcomment -%}
  <div class="top-navbar">
    <button class="mobile-menu-btn" type="button" aria-label="Open menu">
      ☰
    </button>
    <div class="nav-logo">
      <a href="#">{{ section.settings.logo_text }}</a>
    </div>

    <div class="nav-message">
      <span>{{ section.settings.top_message }}</span>
    </div>

    <div class="nav-action">
      <a href="{{ section.settings.top_btn_link | default: '#' }}" class="btn btn--pill">
        <span>{{ section.settings.top_btn_text }}</span>
        <span class="btn-arrow">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>

  {%- comment -%} ================= Hero Banner Section ================= {%- endcomment -%}
  <div class="hero-banner-container">

    <div class="hero-image-wrapper">
      {%- if section.settings.bg_image != blank -%}
        <img
          src="{{ section.settings.bg_image | image_url: width: 2000 }}"
          alt="{{ section.settings.heading | escape }}"
          class="hero-bg-img"
          loading="eager"
          width="{{ section.settings.bg_image.width }}"
          height="{{ section.settings.bg_image.height }}"
        >
      {%- endif -%}
    </div>

    <div class="banner-overlay-content">
      <h1 class="banner-title">{{ section.settings.heading }}</h1>
      <p class="banner-description banner-description--desktop">{{ section.settings.description | replace: '//', '<br>' }}</p>
      <p class="banner-description banner-description--mobile">{{ section.settings.mobile_description | default: section.settings.description | replace: '//', '<br>' }}</p> 
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--solid">
        <span>{{ section.settings.button_text }}</span>
        <span class="btn-arrow">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>

  </div>

  {%- comment -%} ================= Bottom Ticker Bar ================= {%- endcomment -%}
  <div class="bottom-ticker-bar">
    <p>{{ section.settings.bottom_ticker_text }}</p>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;600;700&display=swap');

  /* ==========================================================
     1. Design Tokens
     ========================================================== */
  .custom-banner-wrapper {
    --font-main: 'Jost', sans-serif;

    --color-text: #000000;
    --color-bg: #ffffff;
    --color-bg-soft: #f5f5f5;
    --color-border: #e5e5e5;
    --color-accent: #f7e252;
    --color-accent-hover: #e2ce3d;
    --color-btn-bg: #000000;
    --color-btn-bg-hover: #222222;
    --color-btn-text: #ffffff;

    --hero-padding: 4vw 6vw;
    --hero-aspect-desktop: 16 / 7;
    --hero-aspect-mobile: 4 / 3;
    --content-max-width: 35vw;
    --content-inset: 6vw;

    --transition-fast: 0.2s ease;
    --transition-base: 0.3s ease;

    width: 100%;
    position: relative;
    font-family: var(--font-main);
  }

  /* ==========================================================
     2. Shared Button Component (used in navbar + hero)
     ========================================================== */
  .btn {
    font-family: var(--font-main);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    line-height: 1;
  }
  .btn-arrow {
    display: inline-flex;
    color: currentColor;
    transition: transform var(--transition-base);
  }
  .btn:hover .btn-arrow {
    transform: translateX(5px);
  }

  .btn--pill {
    background-color: var(--color-accent);
    color: var(--color-text);
    padding: 17px 30px;
    font-size: 16px;
    border-radius: 2px;
    transition: background-color var(--transition-fast);
  }
  .btn--pill:hover {
    background-color: var(--color-accent-hover);
  }
  .btn--pill .btn-arrow svg {
    width: 20px;
    height: 20px;
  }

  .btn--solid {
    background-color: var(--color-btn-bg);
    color: var(--color-btn-text);
    padding: 20px 60px;
    font-size: 16px;
    transition: background-color var(--transition-base);
    gap: 10px;
  }
  .btn--solid:hover {
    background-color: var(--color-btn-bg-hover);
  }
  .btn--solid .btn-arrow svg {
    width: 20px;
  }

  /* ==========================================================
     3. Top Navbar
     ========================================================== */
  .top-navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    background-color: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    z-index: 10;
  }
  .mobile-menu-btn{
  display:none;
}
  .nav-logo a {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .nav-message {
    font-size: 16px;
    color: #333333;
  }

  /* ==========================================================
     4. Hero Section
     ========================================================== */
  .hero-banner-container {
    position: relative;
    max-width: 100%;
    aspect-ratio: var(--hero-aspect-desktop);
    display: flex;
    align-items: center;
    padding: var(--hero-padding);
    box-sizing: border-box;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .hero-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
  }

  .banner-overlay-content {
    position: absolute;
    z-index: 2;
    max-width: var(--content-max-width);
    left: var(--content-inset);
    bottom: 5%;
  }
  .banner-title {
  font-size: 80px;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1;
  margin-top: 20px ;
}
  .banner-description {
    font-size: 25px;
    font-weight: 400;
    color: var(--color-text);
    line-height: 140%;
    margin: 0 0 3vw;
  }
  .banner-description--mobile {
  display: none;
}

@media (max-width: 768px) {
  .banner-description--desktop {
    display: none;
  }
  .banner-description--mobile {
    display: block;
  }
}

  /* ==========================================================
     5. Bottom Ticker Bar
     ========================================================== */
  .bottom-ticker-bar {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 8px 50px;
    background-color: var(--color-bg-soft);
    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .button_text{
    opacity:0.8 ;
  }

  /* ==========================================================
     6. Responsive
     ========================================================== */
  @media (max-width: 768px) {
    .top-navbar {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      gap: 10px;
      text-align: center;
      padding: 15px 20px;
    }
    .nav-message{
      display: none;
    }
    .nav-action{
    display: none;
  }
  .mobile-menu-btn{
    display: flex;
  }
    
    .hero-banner-container {
      aspect-ratio: 232 / 322;
      padding: 0;
      min-height: 320px;
      position: relative;
      width: 100%;
    height: auto;
    overflow: hidden;

    background: #fff;

    }
    .banner-overlay-content {
      max-width: 100%;
      left: 20px;
    }
    .banner-title {
      font-size: 30px;
      position: absolute;
      left: 50%;
    }
    .btn--solid {
      padding: 14px 32px;
    }
  }

@media (min-width: 769px) and (max-width: 1400px) {
  .banner-title {
    font-size: 48px;
  }
  .banner-overlay-content {
    max-width: 40vw;
    left: 4vw;
    bottom: 6%;
  }
  .banner-title{
    font-size: 30px;
    line-height: 100%;
  }
  .banner-description {
    font-size: 16px;
    text-align: center;
  }
}

@media (max-width: 768px) {
  .top-navbar {
    flex-direction: column;
    gap: 10px;
    text-align: center;
    padding: 15px 20px;
  }
  .hero-banner-container {
    aspect-ratio: var(--hero-aspect-mobile);
    padding: 30px 20px;
    min-height: 320px;
  }
  .banner-overlay-content {
    max-width: 100%;
    left: 20px;
  }
  .btn--solid {
    padding: 14px 32px;
  }
}
@media (max-width: 768px) {
  .hero-banner-container {
    flex-direction: column;
    align-items: flex-start;
    height: auto;
    aspect-ratio: auto;
    padding: 20px;
  }
  .hero-image-wrapper {
    position: relative;
    order: 2;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-top: 12px;
  }
  .banner-overlay-content {
    position: static;
    order: 1;
    max-width: 100%;
    z-index: 2;
  }
  .banner-title {
    font-size: 28px;
    margin-top: 0;
  }
  .banner-description {
    font-size: 14px;
    margin-bottom: 0;
  }
  .banner-overlay-content .btn--solid {
    position: absolute;
    bottom: 20px;
    left: 20px;
    z-index: 3;
  }

}
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top Announcement Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_ticker_text",
      "label": "Bottom Ticker Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "textarea",
      "id": "mobile_description",
      "label": "Description Text (Mobile)",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
