<div class="custom-banner-wrapper">
  <!-- Top Navbar / Announcement Bar -->
  <div class="top-navbar">
    <div class="nav-logo">
      <a href="#">{{ section.settings.logo_text }}</a>
    </div>
    
    <div class="nav-message">
      <span>{{ section.settings.top_message }}</span>
    </div>
    
    <div class="nav-action">
      <a href="{{ section.settings.top_btn_link | default: '#' }}" class="choose-gift-btn">
        {{ section.settings.top_btn_text }} &rarr;
      </a>
    </div>
  </div>

  <!-- Hero Banner Section -->
  <div class="hero-banner-container">
    

    <div class="hero-image-wrapper">
      {% if section.settings.bg_image != blank %}
  <img 
    src="{{ section.settings.bg_image | image_url: width: 2000 }}" 
    alt="{{ section.settings.heading | escape }}"
    class="hero-bg-img"
    loading="eager"
    width="{{ section.settings.bg_image.width }}"
    height="{{ section.settings.bg_image.height }}"
  >
  {% endif %}
    </div>


    <div class="banner-overlay-content">
      <h1 class="banner-title">{{ section.settings.heading }}</h1>
      <p class="banner-description">{{ section.settings.description | replace: '//', '<br>' }}</p>
      <a href="{{ section.settings.button_link | default: '#' }}" class="banner-shop-btn">
        <span>{{ section.settings.button_text }}</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>

  </div>

  <!-- Bottom Ticker Bar -->
  <div class="bottom-ticker-bar">
    <p>{{ section.settings.bottom_ticker_text }}</p>
  </div>
</div>

<style>
  .custom-banner-wrapper {
    width: 100%;
    position: relative;
  }

  /* Top Navbar */
  .top-navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    background-color: #f5f5f5;
    border-bottom: 1px solid #e5e5e5;
    position: relative;
    z-index: 10;
  }
  .nav-logo a {
    font-size: 11px;
    font-weight: 800;
    color: #000;
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .nav-message {
    font-size: 13px;
    color: #333;
  }
  .choose-gift-btn {
    background-color: #f7e252;
    color: #000;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: bold;
    text-decoration: none;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }
  .choose-gift-btn:hover {
    background-color: #e2ce3d;
  }

  /* Hero Container - الاعتماد على نسبة أبعاد ثابتة لتتكيف مع الزوم دون تغير */
  .hero-banner-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7; /* نسبة العرض للارتفاع الثابتة للسكشن */
    min-height: 400px;
    display: flex;
    align-items: center;
    padding: 4vw 6vw; /* المسافات الخارجية تتناسب تلقائياً مع حجم الشاشة */
    box-sizing: border-box;
    overflow: hidden;
    background-color: #ffffff;
  }

  /* ديف الصورة المطلق */
  .hero-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* الصورة تغطي 100% عرض وطول دون قص أجزاء منها */
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: fill; /* يضمن تمدد الصورة بالكامل 100% عرضاً وطولاً */
    display: block;
  }

  /* المحتوى النصي */
  .banner-overlay-content {
    position: relative;
    z-index: 2;
    max-width: 35vw;
    top:30%;
  }

  .banner-title {
    font-size: 60px; 
    font-weight: 500;
    margin: 2vw 0 1.2vw 0;
    color: #000;
    line-height: 1.1;
  }
  .banner-description {
    font-size: clamp(12px, 1.2vw, 15px);
    color: #000;
    line-height: 1.5;
    margin-bottom: 2vw;
  }
  .banner-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #000;
    color: #fff;
    padding: clamp(8px, 1vw, 16px) clamp(16px, 1.8vw, 32px);
    text-decoration: none;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 1px;
    transition: background-color 0.3s ease;
  }
  .banner-shop-btn .arrow {
    transition: transform 0.3s ease;
  }
  .banner-shop-btn:hover {
    background-color: #222;
  }
  .banner-shop-btn:hover .arrow {
    transform: translateX(5px);
  }

  /* Bottom Ticker */
  .bottom-ticker-bar {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 6px 10px;
    background-color: #f5f5f5;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #000;
  }

  @media (max-width: 768px) {
    .top-navbar {
      flex-direction: column;
      gap: 10px;
      text-align: center;
      padding: 15px 20px;
    }
    .hero-banner-container {
      aspect-ratio: 4 / 3; /* تعديل النسبة للموبايل لتبقى واضحة ومناسبة */
      padding: 30px 20px;
      min-height: 320px;
    }
    .banner-overlay-content {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top Announcement Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_ticker_text",
      "label": "Bottom Ticker Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}