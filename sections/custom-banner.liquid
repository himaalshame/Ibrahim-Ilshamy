<section class="custom-banner">

  <div class="banner-canvas">

    <!-- Background Drawing -->
    {% if section.settings.bg_image != blank %}
      <img
        src="{{ section.settings.bg_image | image_url: width: 2000 }}"
        alt="{{ section.settings.heading | escape }}"
        class="hero-bg-img"
        loading="eager"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
      >
    {% endif %}


    <!-- Top Navigation -->
    <div class="banner-top">

      <div class="banner-logo">
        {{ section.settings.logo_text }}
      </div>

      <div class="nav-message">
        <span>{{ section.settings.top_message }}</span>
      </div>

      <div class="nav-action">
        <a
          href="{{ section.settings.top_btn_link | default: '#' }}"
          class="choose-gift-btn"
        >
          <span>{{ section.settings.top_btn_text }}</span>
          <span class="top-arrow">→</span>
        </a>
      </div>

    </div>


    <!-- Main Content -->
    <div class="banner-overlay-content">

      <h1 class="banner-title">
        {{ section.settings.heading }}
      </h1>

      <p class="banner-description">
        {{ section.settings.description | replace: '//', '<br>' }}
      </p>

      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="banner-shop-btn"
      >
        <span>{{ section.settings.button_text }}</span>
        <span class="arrow">→</span>
      </a>

    </div>


    <!-- Bottom Ticker -->
    <div class="banner-ticker">
      {{ section.settings.bottom_ticker_text }}
    </div>

  </div>

</section>


<style>

  /* =========================================
     MAIN CANVAS
  ========================================= */

  .custom-banner {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  /*
    نفس نسبة الصورة الأصلية:
    616 / 376

    وبالتالي لما العرض يتغير
    الارتفاع يتغير بنفس النسبة.
  */

  .banner-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 616 / 376;
    overflow: hidden;

    /*
      بنستخدم container units
      علشان النصوص نفسها تكبر وتصغر
      مع حجم الرسمة.
    */
    container-type: inline-size;
  }


  /* =========================================
     BACKGROUND DRAWING
  ========================================= */

  .hero-bg-img {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    /*
      الصورة نفسها كاملة
      ومش هتتقص.
    */
    object-fit: fill;

    display: block;

    z-index: 1;
  }


  /* =========================================
     TOP BAR
  ========================================= */

  .banner-top {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;

    /*
      ارتفاع الـ Header بالنسبة للصورة
    */
    height: 7.2%;

    z-index: 10;

    display: flex;
    align-items: center;
  }


  /* =========================================
     LOGO
  ========================================= */

  .banner-logo {
    position: absolute;

    left: 4.8%;
    top: 18%;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 2.1cqw;
    font-weight: 700;

    line-height: 1;

    letter-spacing: 0.02em;

    color: #111;

    white-space: nowrap;
  }


  /* =========================================
     TOP MESSAGE
  ========================================= */

  .nav-message {
    position: absolute;

    left: 50%;
    top: 20%;

    transform: translateX(-50%);

    font-family: Arial, Helvetica, sans-serif;

    font-size: 1.15cqw;
    font-weight: 400;

    color: #111;

    white-space: nowrap;
  }


  /* =========================================
     CHOOSE GIFT BUTTON
  ========================================= */

  .nav-action {
    position: absolute;

    right: 3.8%;
    top: 13%;

    height: 70%;
  }

  .choose-gift-btn {
    height: 100%;

    display: flex;
    align-items: center;

    padding: 0 2.1cqw;

    background: #fff000;

    color: #111;

    text-decoration: none;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 1.05cqw;
    font-weight: 600;

    white-space: nowrap;
  }

  .top-arrow {
    margin-left: 1.1cqw;

    font-size: 1.5cqw;
    line-height: 1;
  }


  /* =========================================
     MAIN CONTENT
  ========================================= */

  .banner-overlay-content {
    position: absolute;

    /*
      مكان المحتوى بالنسبة للصورة
    */

    left: 4.8%;
    top: 55.2%;

    z-index: 5;

    width: 37%;
  }


  /* =========================================
     HEADING
  ========================================= */

  .banner-title {
    margin: 0 0 3.2% 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 6cqw;

    font-weight: 500;

    line-height: 0.95;

    letter-spacing: -0.035em;

    color: #000;
  }


  /* =========================================
     DESCRIPTION
  ========================================= */

  .banner-description {
    margin: 0 0 5.5% 0;

    max-width: 31cqw;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 1.35cqw;

    line-height: 1.45;

    font-weight: 400;

    color: #111;
  }


  /* =========================================
     SHOP NOW BUTTON
  ========================================= */

  .banner-shop-btn {
    display: inline-flex;

    align-items: center;
    justify-content: space-between;

    width: 15.2cqw;
    height: 5.5cqw;

    padding: 0 1.8cqw;

    background: #050505;

    color: #fff;

    text-decoration: none;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 1.05cqw;

    font-weight: 500;

    box-sizing: border-box;
  }

  .banner-shop-btn .arrow {
    font-size: 1.5cqw;

    line-height: 1;
  }


  /* =========================================
     BOTTOM TICKER
  ========================================= */

  .banner-ticker {
    position: absolute;

    left: 0;
    bottom: 0;

    width: 100%;

    height: 4.3%;

    z-index: 10;

    display: flex;
    align-items: center;
    justify-content: center;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 0.95cqw;

    font-weight: 500;

    color: #111;

    white-space: nowrap;

    text-align: center;
  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 600px) {

    .banner-canvas {
      /*
        ما نغيرش الـ aspect ratio
        علشان الرسمة تفضل كاملة.
      */
      aspect-ratio: 616 / 376;
    }

    .banner-title {
      letter-spacing: -0.04em;
    }

    .banner-description {
      line-height: 1.35;
    }

  }

</style>


{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top Announcement Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination.//Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_ticker_text",
      "label": "Bottom Ticker Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}