<div class="custom-banner-wrapper">
  <!-- Top Navbar / Announcement Bar -->
  <div class="top-navbar">
    <div class="nav-logo">
      <a href="">{{ section.settings.logo_text }}</a>
    </div>
    
    <div class="nav-message">
      <span>{{ section.settings.top_message }}</span>
    </div>
    
    <div class="nav-action">
      <a href="{{ section.settings.top_btn_link | default: '#' }}" class="choose-gift-btn">
        {{ section.settings.top_btn_text }} &rarr;
      </a>
    </div>
  </div>

  <!-- Hero Banner Content -->
  <div class="hero-banner" style="background-image: url('{% if section.settings.bg_image != blank %}{{ section.settings.bg_image | image_url: width: 1400 }}{% else %}https://via.placeholder.com/1400x600{% endif %}');">
    <div class="banner-overlay-content">
      <h1 class="banner-title">{{ section.settings.heading }}</h1>
      <p class="banner-description">{{ section.settings.description }}</p>
      <a href="{{ section.settings.button_link | default: '#' }}" class="banner-shop-btn">
        <span>{{ section.settings.button_text }}</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Bottom Ticker Bar -->
  <div class="bottom-ticker-bar">
    <p>{{ section.settings.bottom_ticker_text }}</p>
  </div>
</div>

<style>
  .top-navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 40px;
    background-color: #ffffff;
    border-bottom: 1px solid #e5e5e5;
  }
  .nav-logo a {
    font-size: 18px;
    font-weight: 800;
    color: #000;
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .nav-message {
    font-size: 13px;
    color: #333;
  }
  .choose-gift-btn {
    background-color: #f7e252;
    color: #000;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: bold;
    text-decoration: none;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }
  .choose-gift-btn:hover {
    background-color: #e2ce3d;
  }
  .hero-banner {
    position: relative;
    width: 100%;
    min-height: 480px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    padding: 40px 80px;
  }
  .banner-overlay-content {
    max-width: 450px;
  }
  .banner-title {
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 15px 0;
    color: #000;
    line-height: 1.1;
  }
  .banner-description {
    font-size: 14px;
    color: #333;
    line-height: 1.5;
    margin-bottom: 25px;
  }
  .banner-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #000;
    color: #fff;
    padding: 12px 24px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    transition: background-color 0.3s ease;
  }
  .banner-shop-btn .arrow {
    transition: transform 0.3s ease;
  }
  .banner-shop-btn:hover {
    background-color: #222;
  }
  .banner-shop-btn:hover .arrow {
    transform: translateX(5px);
  }
  .bottom-ticker-bar {
    text-align: center;
    padding: 12px 10px;
    background-color: #fcfcfc;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #444;
  }